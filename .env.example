# Server-side only — never expose these to the browser or prefix them with VITE_
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Legacy fallback only; Supabase is deprecating service_role API keys by end of 2026.
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

FINNHUB_API_KEY=your-finnhub-api-key

# Shared portfolio visible and writable to all visitors. Required; no automatic fallback.
DEFAULT_PORTFOLIO_ID=
