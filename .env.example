# Public browser configuration for Supabase Auth.
# Use the project URL and a publishable/anon key. Never use service_role or secret keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional, server-side only: live quotes, asset search and history.
# Local portfolio storage and manual transactions work without this key.
FINNHUB_API_KEY=your-finnhub-api-key
