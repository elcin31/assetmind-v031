{
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vercel/node": "5.10.2",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.81.0",
    "typescript": "6.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "name": "assetmind-v2",
  "packageManager": "npm@12.0.2",
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "e2e:auth": "node tests/browser/authenticated-production.mjs",
    "e2e:auth:check": "node --check tests/browser/authenticated-production.mjs",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "verify": "npm run typecheck && npm test && npm run lint && npm run e2e:auth:check && npm run build",
    "e2e:overview": "node tests/browser/analytics.mjs"
  },
  "type": "module",
  "version": "0.1.0"
}
